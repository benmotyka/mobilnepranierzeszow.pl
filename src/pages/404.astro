---
import Base from '../layouts/Base.astro';
import { SERVICES } from '../data/site';
---
<Base title="Nie ma takiej strony – Mobilne Pranie Rzeszów" description="Ta strona nie istnieje." noindex>
  <section class="wrap section">
    <div class="section-head">
      <h1>Nie ma takiej strony</h1>
      <p class="lead">Link mógł się zmienić. Zobacz nasze usługi albo wróć na <a href="/">stronę główną</a>.</p>
    </div>
    <ul>{SERVICES.map((s) => <li><a href={`/${s.slug}`}>{s.h1}</a></li>)}</ul>
  </section>
</Base>

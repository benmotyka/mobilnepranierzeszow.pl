---
import '@fontsource-variable/figtree';
import '@fontsource-variable/bricolage-grotesque';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileBar from '../components/MobileBar.astro';
import JsonLd from '../components/JsonLd.astro';
import { SITE, SERVICES, TOWNS } from '../data/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
}
const { title, description, ogImage = '/og.png', ogType = 'website', noindex = false, schema } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const og = new URL(ogImage, SITE.url).href;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#firma`,
  name: SITE.name,
  url: SITE.url,
  telephone: SITE.phone.replace(/\s/g, ''),
  image: `${SITE.url}/og.png`,
  logo: `${SITE.url}/logo.png`,
  description:
    'Mobilne pranie tapicerki meblowej i samochodowej, materacy i dywanów u klienta w domu. Rzeszów i okolice.',
  priceRange: SITE.priceRange,
  currenciesAccepted: 'PLN',
  paymentAccepted: 'Gotówka, BLIK, przelew',
  address: { '@type': 'PostalAddress', addressLocality: 'Rzeszów', addressRegion: 'podkarpackie', addressCountry: 'PL' },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  areaServed: [
    { '@type': 'City', name: 'Rzeszów' },
    ...TOWNS.map((t) => ({ '@type': 'Place', name: t.name })),
  ],
  openingHoursSpecification: SITE.hoursSchema.map((h) => ({
    '@type': 'OpeningHoursSpecification', dayOfWeek: h.days, opens: h.opens, closes: h.closes,
  })),
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Pranie tapicerki',
    itemListElement: SERVICES.map((s) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: s.h1, url: `${SITE.url}/${s.slug}` },
    })),
  },
  sameAs: [SITE.facebookUrl, SITE.instagramUrl, SITE.googleReviewsUrl].filter(Boolean),
};
const schemas = [business, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#1550a8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="geo.region" content="PL-18" />
    <meta name="geo.placename" content="Rzeszów" />
    <JsonLd data={schemas} />
  </head>
  <body>
    <a class="skip sr-only" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
    <MobileBar />
  </body>
</html>

<style>
  .skip:focus { position: fixed; left: 12px; top: 12px; width: auto; height: auto; clip: auto; padding: 10px 14px; background: var(--surface); z-index: 100; }
</style>

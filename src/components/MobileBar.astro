---
import Icon from './Icon.astro';
import { SITE, waLink } from '../data/site';
---
<div class="mbar" role="region" aria-label="Szybki kontakt">
  <a class="btn btn-ghost" href={SITE.phoneHref}><Icon name="phone" size={18} />Zadzwoń</a>
  <a class="btn btn-wa" href={waLink()} rel="noopener"><Icon name="wa" size={18} />WhatsApp</a>
</div>
<style>
  .mbar { display: none; }
  @media (max-width: 880px) {
    .mbar { display: grid; grid-template-columns: 1fr 1.4fr; gap: 8px; position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px 12px calc(10px + env(safe-area-inset-bottom, 0px)); background: var(--surface); border-top: 1px solid var(--line); box-shadow: 0 -8px 24px rgba(13,43,62,.08); }
    :global(body) { padding-bottom: 76px; }
  }
</style>

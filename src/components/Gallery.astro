---
import { Image, getImage } from 'astro:assets';
import type { Photo } from '../lib/gallery';
import Icon from './Icon.astro';
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';

// schema: dane ImageGallery dla Google (tylko na stronach galerii, żeby nie dublować zdjęć).
interface Props { photos: Photo[]; limit?: number; showCategory?: boolean; schema?: boolean }
const { photos, limit, showCategory = true, schema = false } = Astro.props;
const list = limit ? photos.slice(0, limit) : photos;
const items = await Promise.all(
  list.map(async (p) => ({ p, full: await getImage({ src: p.src, width: 1800, format: 'webp', quality: 80 }) })),
);
const ld = schema && {
  '@context': 'https://schema.org', '@type': 'ImageGallery', url: new URL(Astro.url.pathname, SITE.url).href,
  associatedMedia: items.map(({ p, full }) => ({
    '@type': 'ImageObject', contentUrl: new URL(full.src, SITE.url).href, name: p.caption, description: p.alt,
    creditText: SITE.name, copyrightNotice: SITE.name, creator: { '@id': `${SITE.url}/#firma` },
  })),
};
---
{ld && <JsonLd data={ld} />}
<ul class="gal" data-gallery>
  {items.map(({ p, full }, i) => (
    <li>
      <a href={full.src} data-lb={i} data-caption={`${p.caption}${p.kind ? ` · ${p.kind === 'przed-po' ? 'przed i po' : p.kind}` : ''}`} aria-label={`Powiększ: ${p.alt}`}>
        <Image class:list={[{ collage: p.kind === 'przed-po' }]} src={p.src} alt={p.alt} widths={[360, 560, 820]} sizes="(max-width: 600px) 50vw, (max-width: 1100px) 33vw, 380px" format="webp" quality={72} loading={i < 3 ? 'eager' : 'lazy'} />
        {(p.kind === 'przed' || p.kind === 'po') && <span class={`tag tag-${p.kind}`}>{p.kind === 'przed' ? 'Przed' : 'Po'}</span>}
        {(showCategory || p.place) && <span class="cap">{p.caption}</span>}
      </a>
    </li>
  ))}
</ul>

<dialog class="lb" aria-label="Podgląd zdjęcia">
  <button class="lb-x" type="button" data-close aria-label="Zamknij"><Icon name="close" size={26} /></button>
  <button class="lb-nav lb-prev" type="button" data-prev aria-label="Poprzednie zdjęcie"><Icon name="left" size={30} /></button>
  <figure>
    <img alt="" draggable="false" />
    <figcaption></figcaption>
  </figure>
  <button class="lb-nav lb-next" type="button" data-next aria-label="Następne zdjęcie"><Icon name="right" size={30} /></button>
</dialog>

<script>
  for (const gal of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const dlg = gal.nextElementSibling as HTMLDialogElement;
    const img = dlg.querySelector('img')!;
    const cap = dlg.querySelector('figcaption')!;
    const links = [...gal.querySelectorAll<HTMLAnchorElement>('a[data-lb]')];
    let i = 0;
    const show = (n: number) => {
      i = (n + links.length) % links.length;
      const a = links[i];
      img.src = a.href;
      img.alt = a.querySelector('img')?.alt ?? '';
      cap.textContent = `${a.dataset.caption ?? ''}  ·  ${i + 1} / ${links.length}`;
    };
    links.forEach((a, n) => a.addEventListener('click', (e) => {
      if (!dlg.showModal) return;
      e.preventDefault(); show(n); dlg.showModal();
    }));
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(i + 1));
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    dlg.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(dx < 0 ? i + 1 : i - 1);
    });
  }
</script>

<style>
  .gal { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 45%), 1fr)); gap: 10px; }
  .gal a { position: relative; display: block; border-radius: 12px; overflow: hidden; aspect-ratio: 1; background: var(--soft); }
  .gal :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform .3s; }
  /* kolaże mają napis „Przed:” u góry, więc przycinamy od dołu */
  .gal :global(img.collage) { object-position: top; }
  .gal a:hover :global(img) { transform: scale(1.03); }
  .tag { position: absolute; left: 10px; top: 10px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 8px; border-radius: 5px; background: rgba(255,255,255,.94); color: var(--ink); }
  .tag-po { background: var(--primary); color: #fff; }
  .cap { position: absolute; inset: auto 0 0 0; padding: 26px 12px 9px; font-size: 14px; font-weight: 600; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.55)); }
  @media (max-width: 480px) { .gal { gap: 6px; } .cap { font-size: 12px; padding: 18px 8px 6px; } }

  .lb { border: 0; padding: 0; margin: 0; inset: 0; width: 100vw; height: 100dvh; max-width: none; max-height: none; background: #06141e; color: #fff; overflow: hidden; }
  .lb[open] { display: grid; grid-template-columns: 64px minmax(0, 1fr) 64px; align-items: center; }
  .lb::backdrop { background: rgba(6, 20, 30, .6); }
  :global(html:has(dialog.lb[open])) { overflow: hidden; }
  .lb figure { grid-column: 2; margin: 0; display: grid; gap: 12px; justify-items: center; align-content: center; min-width: 0; height: 100%; padding: 60px 0 24px; box-sizing: border-box; }
  .lb img { display: block; max-width: 100%; max-height: calc(100dvh - 140px); width: auto; height: auto; object-fit: contain; border-radius: 8px; user-select: none; }
  .lb figcaption { font-size: 15px; color: #cfe0ea; text-align: center; padding-inline: 12px; }
  .lb button { all: unset; box-sizing: border-box; cursor: pointer; color: #fff; display: grid; place-items: center; border-radius: 999px; transition: background .2s; }
  .lb button:hover { background: rgba(255, 255, 255, .12); }
  .lb button:focus-visible { outline: 3px solid var(--aqua-lt); }
  .lb .lb-nav { width: 52px; height: 52px; justify-self: center; }
  .lb .lb-prev { grid-column: 1; grid-row: 1; }
  .lb .lb-next { grid-column: 3; grid-row: 1; }
  .lb .lb-x { position: absolute; right: 14px; top: 14px; width: 44px; height: 44px; z-index: 1; }
  @media (max-width: 600px) {
    .lb[open] { grid-template-columns: minmax(0, 1fr); }
    .lb figure { grid-column: 1; padding: 64px 0 84px; }
    .lb img { max-height: calc(100dvh - 190px); border-radius: 0; }
    .lb .lb-nav { position: absolute; bottom: 16px; width: 52px; height: 52px; background: rgba(255, 255, 255, .1); }
    .lb .lb-prev { left: 20px; }
    .lb .lb-next { right: 20px; left: auto; }
  }
</style>

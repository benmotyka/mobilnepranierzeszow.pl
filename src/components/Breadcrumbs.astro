---
import JsonLd from './JsonLd.astro';
import { SITE } from '../data/site';
interface Props { items: { name: string; href: string }[] }
const items = [{ name: 'Strona główna', href: '/' }, ...Astro.props.items];
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((it, i) => ({
    '@type': 'ListItem', position: i + 1, name: it.name, item: new URL(it.href, SITE.url).href,
  })),
};
---
<nav class="breadcrumbs wrap" aria-label="Okruszki">
  <ol>
    {items.map((it, i) => (
      <li>{i < items.length - 1 ? <a href={it.href}>{it.name}</a> : <span aria-current="page">{it.name}</span>}</li>
    ))}
  </ol>
</nav>
<JsonLd data={ld} />

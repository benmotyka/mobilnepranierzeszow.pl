---
// Para zdjęć przed/po z galerii. Dopóki nie ma zdjęć: makieta rozmowy z wyceną na WhatsApp.
import { Image } from 'astro:assets';
import { firstPair } from '../lib/gallery';
interface Props { category?: string; example?: { nom: string; gen: string; price: string } }
const { category, example = { nom: 'Taki narożnik', gen: 'takiego narożnika', price: '199 zł' } } = Astro.props;
const pair = firstPair(category) ?? firstPair();
---
{pair ? (
  <div class="pair">
    <figure><Image src={pair.before.src} alt={pair.before.alt} widths={[320, 520]} sizes="(max-width: 800px) 45vw, 260px" format="webp" loading="eager" /><span class="tag">Przed</span></figure>
    <figure><Image src={pair.after.src} alt={pair.after.alt} widths={[320, 520]} sizes="(max-width: 800px) 45vw, 260px" format="webp" loading="eager" /><span class="tag tag-po">Po</span></figure>
  </div>
) : (
  <div class="chat" aria-label="Przykład wyceny na WhatsApp">
    <p class="chat-head"><span class="av"><img src="/favicon.svg" alt="" width="26" height="26" /></span><span><b>Mobilne Pranie Rzeszów</b><small>zwykle odpowiada w 15 minut</small></span></p>
    <div class="msg me">
      <span class="photo" aria-hidden="true"></span>
      Dzień dobry, ile za pranie {example.gen}? Mieszkam na Słocinie.
      <time>9:41</time>
    </div>
    <div class="msg them">Dzień dobry! {example.nom} to {example.price}, dojazd na Słocinę w cenie. Pasuje sobota 10:00?<time>9:52</time></div>
    <div class="msg me">Pasuje, dziękuję!<time>9:53</time></div>
    <p class="note">Przykładowa rozmowa</p>
  </div>
)}
<style>
  .pair { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; background: var(--surface); padding: 8px; border-radius: 18px; box-shadow: 0 20px 50px rgba(13,43,62,.12); }
  .pair figure { margin: 0; position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 3 / 4; }
  .pair :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .tag { position: absolute; left: 10px; top: 10px; font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: 4px 8px; border-radius: 5px; background: rgba(255,255,255,.94); color: var(--ink); }
  .tag-po { background: var(--primary); color: #fff; }
  .chat { background: #e9efe6; border-radius: 22px; padding: 14px; box-shadow: 0 20px 50px rgba(13,43,62,.14); display: grid; gap: 10px; max-width: 440px; justify-self: center; width: 100%; font-size: 15px; line-height: 1.4; }
  .chat-head { display: flex; align-items: center; gap: 10px; background: var(--surface); border-radius: 14px; padding: 10px 12px; }
  .chat-head small { display: block; color: var(--muted); font-size: 12px; }
  .av { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; flex: none; box-shadow: inset 0 0 0 1px var(--line); }
  .av { display: grid; place-items: center; background: #fff; }
  .av img { width: 26px; height: 26px; }
  .msg { max-width: 84%; padding: 9px 12px 18px; border-radius: 14px; position: relative; background: var(--surface); }
  .msg time { position: absolute; right: 10px; bottom: 4px; font-size: 11px; color: var(--muted); }
  .me { justify-self: end; background: #d6f5c8; border-bottom-right-radius: 4px; }
  .them { border-bottom-left-radius: 4px; }
  .photo { display: block; height: 120px; border-radius: 10px; margin: -3px -6px 8px; background:
    radial-gradient(14% 12% at 30% 60%, rgba(70,48,25,.45), transparent 70%),
    radial-gradient(10% 9% at 68% 40%, rgba(70,48,25,.4), transparent 70%),
    repeating-linear-gradient(45deg, rgba(255,255,255,.07) 0 2px, transparent 2px 6px),
    linear-gradient(160deg, #9a8f84, #7d746b); }
  .note { font-size: 12px; color: var(--muted); text-align: center; }
</style>

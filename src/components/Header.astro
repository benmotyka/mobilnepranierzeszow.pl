---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, SERVICES, waLink } from '../data/site';
const path = Astro.url.pathname;
const links = [
  { href: '/cennik', label: 'Cennik' },
  { href: '/galeria', label: 'Galeria' },
  { href: '/obszar-dojazdu', label: 'Dojazd' },
  { href: '/poradnik', label: 'Poradnik' },
  { href: '/kontakt', label: 'Kontakt' },
];
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="hdr">
  <div class="wrap bar">
    <a class="logo" href="/" aria-label={`${SITE.name} – strona główna`}>
      <Logo size={40} />
    </a>
    <nav class="nav" aria-label="Główna nawigacja">
      <details class="dd">
        <summary>Usługi</summary>
        <ul>
          {SERVICES.map((s) => <li><a href={`/${s.slug}`}>{s.short}</a></li>)}
        </ul>
      </details>
      {links.map((l) => <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <div class="actions">
      <a class="tel" href={SITE.phoneHref}><Icon name="phone" size={18} />{SITE.phone}</a>
      <a class="btn btn-primary" href={waLink()} rel="noopener">Wycena</a>
    </div>
    <details class="burger">
      <summary aria-label="Menu"><Icon name="menu" size={26} /></summary>
      <div class="panel">
        <p class="ph">Usługi</p>
        {SERVICES.map((s) => <a href={`/${s.slug}`}>{s.short}</a>)}
        <hr />
        {links.map((l) => <a href={l.href}>{l.label}</a>)}
      </div>
    </details>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 30; background: color-mix(in srgb, var(--bg) 92%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; gap: 20px; min-height: 66px; }
  .logo { display: flex; text-decoration: none; white-space: nowrap; }
  .nav { display: flex; align-items: center; gap: 22px; margin-left: 12px; font-weight: 600; font-size: 16px; }
  .nav > a, .dd summary { color: var(--muted); text-decoration: none; cursor: pointer; }
  .nav > a:hover, .dd summary:hover, .nav > a[aria-current] { color: var(--ink); }
  .dd { position: relative; }
  .dd summary { list-style: none; }
  .dd summary::-webkit-details-marker { display: none; }
  .dd summary::after { content: '▾'; font-size: 12px; margin-left: 4px; }
  .dd ul { position: absolute; top: calc(100% + 12px); left: -14px; list-style: none; margin: 0; padding: 8px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px; box-shadow: 0 14px 40px rgba(13,43,62,.12); min-width: 240px; }
  .dd ul a { display: block; padding: 8px 10px; border-radius: 8px; text-decoration: none; color: var(--ink); }
  .dd ul a:hover { background: var(--soft); }
  .actions { margin-left: auto; display: flex; align-items: center; gap: 14px; }
  .tel { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; text-decoration: none; color: var(--ink); white-space: nowrap; }
  .burger { display: none; margin-left: auto; }
  .burger summary { list-style: none; cursor: pointer; padding: 6px; color: var(--ink); }
  .burger summary::-webkit-details-marker { display: none; }
  .panel { position: absolute; left: 0; right: 0; top: 100%; background: var(--surface); border-bottom: 1px solid var(--line); padding: 10px var(--gutter) 18px; display: grid; box-shadow: 0 20px 40px rgba(13,43,62,.12); max-height: calc(100vh - 66px); overflow-y: auto; }
  .panel a { padding: 10px 0; font-weight: 600; text-decoration: none; color: var(--ink); border-bottom: 1px solid var(--soft); }
  .panel .ph { font-size: 13px; text-transform: uppercase; letter-spacing: .1em; color: var(--aqua); font-weight: 700; margin-top: 4px; }
  .panel hr { border: 0; margin: 6px 0; }
  @media (max-width: 1020px) { .tel { display: none; } }
  @media (max-width: 880px) {
    .nav, .actions { display: none; }
    .burger { display: block; }
  }
</style>

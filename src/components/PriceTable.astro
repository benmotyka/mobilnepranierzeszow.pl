---
import type { PriceRow } from '../data/site';
interface Props { rows: PriceRow[]; caption?: string }
const { rows, caption } = Astro.props;
---
<div class="card list">
  {caption && <p class="cap">{caption}</p>}
  {rows.map((r) => (
    <div class="row"><span class="n">{r.name}{r.note && <small>{r.note}</small>}</span><span class="price">{r.price}</span></div>
  ))}
</div>
<style>
  .list { overflow: hidden; }
  .cap { padding: 14px 20px 0; font-weight: 700; color: var(--aqua); font-size: 13px; text-transform: uppercase; letter-spacing: .1em; }
  .row { display: flex; justify-content: space-between; gap: 16px; padding: 14px 20px; border-top: 1px solid var(--line); align-items: baseline; }
  .cap + .row { border-top: 0; }
  .list > .row:first-child { border-top: 0; }
  .n { font-weight: 600; min-width: 0; }
  .n small { display: block; color: var(--muted); font-weight: 400; font-size: 14px; }
  .price { font-weight: 700; color: var(--primary); }
</style>
